{
  "name": "web-praising",
  "description": "Praising è la tua web-app per visualizzare testi e accordi dei canti cristiani più famosi.",
  "version": "0.5.9",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && python3 script.py --fix-service-worker=True",
    "start": "next start",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "deploy": "python3 script.py --generate-revisions=True && vercel build --prod && vercel --prebuilt --prod",
    "lint:next": "next lint --fix",
    "lint:fix": "eslint --fix .",
    "lint:check": "eslint .",
    "linter": "npm run lint:check && npm run lint:next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set_cors_fb": "gsutil cors set cors_firebase_storage.json gs://praising-web.appspot.com",
    "knip": "knip"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@firebase/auth": "^1.8.0",
    "@firebase/firestore": "^4.7.4",
    "@firebase/storage": "^0.13.3",
    "@mui/icons-material": "^6.0.1",
    "@mui/material": "^6.0.1",
    "@mui/x-date-pickers": "^7.14.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@serwist/next": "^9.0.2",
    "@vercel/speed-insights": "^1.0.12",
    "cheerio": "^1.0.0",
    "chordsheetjs": "^10.3.0",
    "dayjs": "^1.11.13",
    "driver.js": "^1.3.1",
    "firebase": "^11.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "next": "^15.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal-sheet": "^3.1.0",
    "react-redux": "^9.0.3",
    "react-screen-wake-lock": "^3.0.1",
    "react-web-share": "^2.0.2",
    "react-youtube": "^10.1.0",
    "sharp": "^0.33.0",
    "smooth-dnd": "^0.12.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^9.13.0",
    "@next/bundle-analyzer": "^15.0.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "@types/html2canvas": "^0.5.35",
    "@types/jspdf": "^1.3.3",
    "@types/node": "^22.5.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-love": "^96.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.11.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.1",
    "globals": "^15.11.0",
    "husky": "^9.1.6",
    "knip": "^5.33.3",
    "prettier": "3.3.3",
    "prop-types": "^15.8.1",
    "serwist": "^9.0.3",
    "typescript": "^5.6.2"
  }
}
