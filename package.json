{
  "name": "web-praising",
  "description": "Praising è la tua web-app per visualizzare testi e accordi dei canti cristiani più famosi.",
  "version": "0.6.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && python3 script.py --fix-service-worker --update-sitemap",
    "start": "next start",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "deploy": "python3 script.py --generate-revisions && vercel build --prod && vercel --prebuilt --prod",
    "lint:fix": "eslint --fix .",
    "lint:check": "eslint .",
    "linter": "npm run lint:check && npm run lint:next",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "set_cors_fb": "gsutil cors set cors_firebase_storage.json gs://praising-web.appspot.com",
    "knip": "knip"
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@firebase/auth": "^1.8.0",
    "@firebase/firestore": "^4.7.4",
    "@firebase/storage": "^0.14.0",
    "@mmbt/react-share-on-social": "^1.1.5",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@mui/x-date-pickers": "^8.10.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@sentry/nextjs": "^10.20.0",
    "@serwist/next": "^9.0.2",
    "@vercel/speed-insights": "^1.0.12",
    "cheerio": "^1.0.0",
    "chordsheetjs": "^12.0.0",
    "dayjs": "^1.11.13",
    "driver.js": "^1.3.1",
    "firebase": "^12.1.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.0",
    "next": "^15.0.0",
    "next-seo": "^6.6.0",
    "nodemailer": "^7.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-h5-audio-player": "^3.10.0-rc.1",
    "react-modal-sheet": "^4.0.1",
    "react-redux": "^9.0.3",
    "react-screen-wake-lock": "^3.0.1",
    "react-youtube": "^10.1.0",
    "sharp": "^0.34.3",
    "smooth-dnd": "^0.12.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/bundle-analyzer": "^15.0.0",
    "@next/eslint-plugin-next": "^15.0.0",
    "@types/node": "^24.3.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.11.0",
    "@typescript-eslint/parser": "^8.11.0",
    "eslint": "^9.13.0",
    "eslint-config-love": "^119.0.0",
    "eslint-config-next": "^15.0.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^17.11.1",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-promise": "^7.1.0",
    "eslint-plugin-react": "^7.37.1",
    "globals": "^16.1.0",
    "husky": "^9.1.6",
    "knip": "^5.33.3",
    "prettier": "^3.5.3",
    "prop-types": "^15.8.1",
    "serwist": "^9.0.3",
    "typescript": "^5.6.2",
    "unlighthouse": "^0.17.2"
  }
}
