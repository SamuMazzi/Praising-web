{
  "name": "web-praising",
  "description": "Praising è la tua web-app per visualizzare testi e accordi dei canti cristiani più famosi.",
  "version": "0.4.7",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && python3 script.py --fix-service-worker=True",
    "start": "next start",
    "analyze": "source-map-explorer 'build/static/js/*.js'",
    "deploy": "python3 script.py --generate-revisions=True && vercel build --prod && vercel --prebuilt --prod",
    "lint:next": "next lint --fix",
    "lint:fix": "eslint --fix --ext .ts,.js,.jsx .",
    "lint:check": "eslint --ext .ts,.js,.jsx .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@emotion/react": "^11.10.5",
    "@emotion/styled": "^11.10.5",
    "@fontsource/poppins": "^5.0.8",
    "@mui/icons-material": "^6.0.1",
    "@mui/material": "^6.0.1",
    "@mui/x-date-pickers": "^7.14.0",
    "@reduxjs/toolkit": "^2.0.1",
    "@serwist/next": "^9.0.2",
    "@vercel/speed-insights": "^1.0.12",
    "axios": "^1.7.2",
    "cheerio": "^1.0.0",
    "chordsheetjs": "^10.3.0",
    "dayjs": "^1.11.7",
    "driver.js": "^1.3.1",
    "firebase": "^10.12.1",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.1",
    "next": "^14.0.4",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-modal-sheet": "^3.1.0",
    "react-redux": "^9.0.3",
    "react-screen-wake-lock": "^3.0.1",
    "react-web-share": "^2.0.2",
    "react-youtube": "^10.1.0",
    "sharp": "^0.33.0",
    "smooth-dnd": "^0.12.1",
    "swr": "^2.0.3"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^14.2.14",
    "@types/node": "^22.5.0",
    "@types/react": "^18.2.21",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-config-standard-with-typescript": "^43.0.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.1",
    "husky": "^9.0.11",
    "prettier": "3.3.3",
    "serwist": "^9.0.3",
    "typescript": "^5.6.2"
  }
}
